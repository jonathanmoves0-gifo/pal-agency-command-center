{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Qualified prospect run generated by the Pal Agency Command Center LangGraph pipeline.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the agency operator who owns this lead."
        },
        "businessName": {
          "type": "string",
          "maxLength": 160
        },
        "niche": {
          "type": "string",
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "enum": ["Uganda", "Kenya", "East Africa", "UK", "US", "EU"]
        },
        "websiteUrl": {
          "type": "string",
          "maxLength": 300
        },
        "painSignal": {
          "type": "string",
          "maxLength": 600
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 180
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 40
        },
        "selectedOffer": {
          "type": "string",
          "enum": ["Automated Mobile Website", "24/7 AI Receptionist", "9:16 AI UGC Ad Script"]
        },
        "attempt1Score": {
          "type": "number"
        },
        "attempt2Score": {
          "type": "number"
        },
        "recalibrated": {
          "type": "boolean"
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["pending", "approved", "recalibrated", "archived"]
        },
        "feedbackNote": {
          "type": "string",
          "maxLength": 400
        },
        "deliverableId": {
          "type": "string",
          "maxLength": 128
        },
        "summarySnapshot": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "niche",
        "region",
        "selectedOffer",
        "attempt1Score",
        "attempt2Score",
        "recalibrated",
        "approvalStatus",
        "deliverableId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Deliverable": {
      "title": "Deliverable",
      "description": "Generated client deliverable template (Mobile Website HTML, AI Receptionist simulation config, or 9:16 UGC script) and 3-touch HITL outreach vault.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the agency operator."
        },
        "leadId": {
          "type": "string",
          "maxLength": 128
        },
        "businessName": {
          "type": "string",
          "maxLength": 160
        },
        "offerType": {
          "type": "string",
          "enum": ["Automated Mobile Website", "24/7 AI Receptionist", "9:16 AI UGC Ad Script"]
        },
        "payload": {
          "type": "object"
        },
        "outreachTouches": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "leadId",
        "businessName",
        "offerType",
        "payload",
        "outreachTouches",
        "createdAt"
      ]
    },
    "CalibrationRule": {
      "title": "CalibrationRule",
      "description": "Self-calibration rule created from HITL Reject & Recalibrate feedback and applied to future LangGraph runs.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the agency operator."
        },
        "ruleText": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "sourceBusiness": {
          "type": "string",
          "maxLength": 160
        },
        "sourceOffer": {
          "type": "string",
          "maxLength": 80
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ruleText",
        "sourceBusiness",
        "sourceOffer",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExecutionLog": {
      "title": "ExecutionLog",
      "description": "Immutable trace log of a LangGraph pipeline execution including stage timings, provider routing, and quality scores.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the agency operator."
        },
        "leadId": {
          "type": "string",
          "maxLength": 128
        },
        "businessName": {
          "type": "string",
          "maxLength": 160
        },
        "providerUsed": {
          "type": "string",
          "maxLength": 120
        },
        "initialScore": {
          "type": "number"
        },
        "calibratedScore": {
          "type": "number"
        },
        "recalibrated": {
          "type": "boolean"
        },
        "stages": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "leadId",
        "businessName",
        "providerUsed",
        "initialScore",
        "calibratedScore",
        "recalibrated",
        "stages",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Agency prospect runs and approval states owned by an operator."
    },
    "/deliverables/{deliverableId}": {
      "schema": { "$ref": "#/entities/Deliverable" },
      "description": "Generated client templates and 3-touch HITL outreach copy linked to leads."
    },
    "/calibration_rules/{ruleId}": {
      "schema": { "$ref": "#/entities/CalibrationRule" },
      "description": "Operator feedback rules applied automatically to future pipeline runs."
    },
    "/execution_logs/{logId}": {
      "schema": { "$ref": "#/entities/ExecutionLog" },
      "description": "Immutable LangGraph execution traces and quality gate comparisons."
    }
  }
}
